<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flashslot.messaging.mapper.NotificationMapper">
    <resultMap id="notification" type="com.flashslot.messaging.entity.Notification" autoMapping="true">
        <id column="id" property="id"/>
        <result column="payload" property="payload" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
    </resultMap>
    <select id="findOwnPage" resultMap="notification">
        SELECT id, user_id, event_id, type, payload, read_at, created_at
        FROM notification
        WHERE user_id = #{userId}
        <if test="request.unreadOnly">AND read_at IS NULL</if>
        <if test="anchor != null">
            AND (created_at &lt; #{anchor.createdAt}
                 OR (created_at = #{anchor.createdAt} AND id &lt; #{anchor.id}))
        </if>
        ORDER BY created_at DESC, id DESC
        LIMIT #{fetchSize}
    </select>
</mapper>
