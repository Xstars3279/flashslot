# Copy to a private deployment .env. Fill every empty secret before starting.
# Do not commit the real .env. Generate JWT_SECRET from at least 32 random bytes (Base64).
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
RABBIT_PASSWORD=
JWT_SECRET=
HTTP_PORT=8080

# Simulation only: code is returned to the UI; no SMS or phone ownership verification.
REGISTRATION_DEVELOPMENT_CODE_ENABLED=true

# Pick a subnet and an unused address if your server already has Docker networks.
NETWORK_SUBNET=172.30.87.0/24
PROXY_IP=172.30.87.254
PROMETHEUS_PORT=9090
